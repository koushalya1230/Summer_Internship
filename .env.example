# FastAPI Server Config
PORT=8000
HOST=0.0.0.0

# Database Configuration (Defaults to SQLite if blank)
DATABASE_URL=sqlite:///./research_platform.db
# PostgreSQL Example: postgresql://user:password@localhost:5432/research_db

# Optional LLM API Key for Advanced Contextual RAG Generation
OPENAI_API_KEY=
LLM_MODEL=gpt-3.5-turbo

# Embedding Model
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
